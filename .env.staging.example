# Staging only. Never copy production values into this file.
APP_ENV=staging
MIGRATION_MODE=airtable

# Dedicated staging data services. These must not resolve to production resources.
DATABASE_URL=postgresql://staging_user:change-me@staging-db.example.invalid/staging_db
REDIS_URL=redis://staging-redis.example.invalid:6379/0

# Dedicated Meta test business assets and number.
WHATSAPP_ACCESS_TOKEN=change-me-staging-token
WHATSAPP_PHONE_NUMBER_ID=staging-meta-test-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=staging-meta-business-account-id
WHATSAPP_APP_SECRET=change-me-staging-app-secret
WHATSAPP_VERIFY_TOKEN=change-me-staging-verify-token

# Dedicated staging Airtable base when airtable or dual mode is under test.
AIRTABLE_API_KEY=change-me-staging-airtable-key
AIRTABLE_BASE_ID=staging-airtable-base-id
AIRTABLE_TABLE_NAME=Leads

# Staging-only application authentication and optional AI.
JWT_SECRET=change-me-staging-jwt-secret
ADMIN_SECRET=change-me-staging-admin-secret
GEMINI_API_KEY=
NINEROUTER_API_KEY=
SENTRY_DSN=

# Existing out-of-scope channels remain disabled.
EMAIL_PLATFORM_ENABLED=false
